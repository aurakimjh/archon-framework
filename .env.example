# Archon Environment Variables

# Anthropic API (Orchestrator / Reviewer)
ANTHROPIC_API_KEY=

# LiteLLM Proxy
LITELLM_MASTER_KEY=
DATABASE_URL=sqlite:///litellm.db

# Redis (Scratchpad)
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Ollama (로컬 추론)
OLLAMA_BASE_URL=http://localhost:11434

# AITOP Monitoring (aiservice-monitoring)
AITOP_SERVER_URL=http://localhost:8080
AITOP_PROJECT_TOKEN=

# Ray
RAY_ADDRESS=auto
