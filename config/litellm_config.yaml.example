model_list:
  # Claude (오케스트레이터 전용)
  - model_name: orchestrator
    litellm_params:
      model: anthropic/claude-opus-4-6
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: reviewer
    litellm_params:
      model: anthropic/claude-sonnet-4-6
      api_key: os.environ/ANTHROPIC_API_KEY

  # 로컬 오픈소스 모델
  - model_name: frontend-agent
    litellm_params:
      model: ollama/qwen3.5:32b
      api_base: http://localhost:11434

  - model_name: backend-agent
    litellm_params:
      model: ollama/deepseek-v3.2:70b
      api_base: http://localhost:11434

  - model_name: tester-agent
    litellm_params:
      model: ollama/gemma4:14b
      api_base: http://localhost:11434

  - model_name: devops-agent
    litellm_params:
      model: ollama/glm-5:14b
      api_base: http://localhost:11434

  - model_name: docs-agent
    litellm_params:
      model: ollama/mimo-v2:7b
      api_base: http://localhost:11434

router_settings:
  routing_strategy: usage-based-routing
  fallbacks:
    - backend-agent: [frontend-agent]
  allowed_fails: 3
  cooldown_time: 60

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
