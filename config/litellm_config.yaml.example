model_list:
  # Claude (오케스트레이터 전용)
  - model_name: orchestrator
    litellm_params:
      model: anthropic/claude-opus-4-6
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: reviewer
    litellm_params:
      model: anthropic/claude-sonnet-4-6
      api_key: os.environ/ANTHROPIC_API_KEY

  # 로컬 오픈소스 모델 (LM Studio)
  - model_name: backend-agent
    litellm_params:
      model: openai/<your-backend-model>
      api_base: http://localhost:1234/v1
      api_key: lm-studio

  - model_name: frontend-agent
    litellm_params:
      model: openai/<your-frontend-model>
      api_base: http://localhost:1234/v1
      api_key: lm-studio

  - model_name: tester-agent
    litellm_params:
      model: openai/<your-tester-model>
      api_base: http://localhost:1234/v1
      api_key: lm-studio

  - model_name: devops-agent
    litellm_params:
      model: openai/<your-devops-model>
      api_base: http://localhost:1234/v1
      api_key: lm-studio

  - model_name: docs-agent
    litellm_params:
      model: openai/<your-docs-model>
      api_base: http://localhost:1234/v1
      api_key: lm-studio

  # --- Ollama (로컬 추론 서버) ---
  # Ollama 설치: https://ollama.com
  # 모델 다운로드: ollama pull llama3:8b
  # 서버 시작: ollama serve (기본 포트 11434)

  - model_name: backend-agent-ollama
    litellm_params:
      model: ollama_chat/llama3:8b
      api_base: http://localhost:11434

  - model_name: tester-agent-ollama
    litellm_params:
      model: ollama_chat/codellama:13b
      api_base: http://localhost:11434

  # 원격 Ollama 서버 (GPU 노드)
  # - model_name: backend-agent-remote
  #   litellm_params:
  #     model: ollama_chat/qwen2.5:32b
  #     api_base: http://gpu-node:11434

router_settings:
  routing_strategy: usage-based-routing
  fallbacks:
    - backend-agent: [frontend-agent]
  allowed_fails: 3
  cooldown_time: 60

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
